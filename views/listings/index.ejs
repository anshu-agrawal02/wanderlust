<% layout('/layouts/boilerplate') -%> 

<div id="filters" class="d-flex flex-nowrap gap-4 overflow-auto" >
    <a href="/listings?category=rooms" class="filter text-center flex-shrink-0">
                <i class="fa-solid fa-bed"></i>
                <p>Rooms</p>
    </a>
    <a href="/listings?category=trending" class="filter text-center flex-shrink-0">
                <i class="fa-solid fa-fire"></i>
                <p>Trending</p>
    </a>
    <a href="/listings?category=mountains" class="filter text-center flex-shrink-0">
                <i class="fa-solid fa-mountain"></i>
                <p>mountains</p>
    </a>
    <a href="/listings?category=iconic city" class="filter text-center flex-shrink-0">
                <i class="fa-solid fa-mountain-city"></i>
                <p>iconic city</p>
    </a>
    <a href="/listings?category=amazing pool" class="filter text-center flex-shrink-0">
                <i class="fa-solid fa-person-swimming"></i>
                <p>Amazing pool</p>
    </a>
    <a href="/listings?category=castles" class="filter text-center flex-shrink-0">
                <i class="fa-brands fa-fort-awesome"></i>
                <p>Castles </p>
    </a>
    <a href="/listings?category=camping" class="filter text-center flex-shrink-0">
                <i class="fa-solid fa-campground"></i>
                <p>camping</p>
    </a>
    <a href="/listings?category=farming" class="filter text-center flex-shrink-0">
                <i class="fa-solid fa-cow"></i>
                <p>Farming</p>
    </a>
    <div class="tax-toggle mt-3">
        <div class="form-check-reverse form-switch">
        <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
        <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
        </div>
    </div>
</div>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for(listing of allListing){ %>
        <a href="/listings/<%= listing._id %>" class="listing-link">
        <div class="card listing-card">
    
    <img src="<%= listing.image.url %>" class="card-img-top" alt="..." style="height: 20rem;">
    <div class="card-img-overlay">   </div>
    <div class="card-body">
    <p class="card-text"> 
        <b> <%= listing.title %></b><br><br>
        <%=listing.description %>
        <br><br>
       &#8360; <%= listing.price.toLocaleString("en-IN") %>
       <i class="tax-info">&nbsp; &nbsp; +18% GST</i>
    </p>
    </div>
    </div>
    </a>
    <% } %>

    </div>

<hr>

<script>
    let taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click",()=>{
        let taxInfo = document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display != "inline"){
                info.style.display = "inline";
            }
            else{
                info.style.display = "none";
            }
        }
    })

    </script>

