<% layout('/layouts/boilerplate') -%>
<body>
    <div class="row">
        <div class="col-8 offset-2">
        <h3>List new property</h3>
        <form method="post" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">
       <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input name="listing[title]" placeholder="title" type="text" class="form-control" required >
        <div class="valid-feedback">title looks good!!</div>
        </div> 
        <div class="mb-3">
        <label for="description" class="form-label">description</label>
        <textarea name="listing[description]" placeholder="describe your property" class="form-control"required></textarea>
        <div class="invalid-feedback">Please enter the valid description</div>
        </div>
        <div class="mb-3">
        <label for="image.url" class="form-label">image</label>
        <input name="listing[image][url]" type="file" class="form-control" required>
        </div>
        
    
        <div class="row">
        <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Price</label>
        <input name="listing[price]" placeholder="enter price" type="number" class="form-control" required>
        <div class="invalid-feedback">Enter the valid price</div>
        </div>
        
        <div class="mb-3 col-md-8">
        <label for="country" class="form-label">country</label>
        <input name="listing[country]" placeholder="country" type="text" class="form-control" required>
        <div class="invalid-feedback">Enter the valid country name</div>
        </div>
        </div>
        <div class="mb-3">
        <label for="location" class="form-label">location</label>
        <input name="listing[location]" placeholder="enter location" type="text" class="form-control" required>
        <div class="invalid-feedback">Enter the valid location</div>
        </div>
        <div class="dropdown mb-3">

    <button
        class="btn btn-outline-secondary dropdown-toggle w-100 text-start"
        type="button"
        data-bs-toggle="dropdown"
        aria-expanded="false">
        Select Category
    </button>

    <ul class="dropdown-menu p-3">

        <li>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    name="listing[category]"
                    value="rooms"
                    id="rooms">

                <label class="form-check-label" for="rooms">
                    Rooms
                </label>
            </div>
        </li>

        <li>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    name="listing[category]"
                    value="trending"
                    id="trending">

                <label class="form-check-label" for="trending">
                    Trending
                </label>
            </div>
        </li>

        <li>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    name="listing[category]"
                    value="mountains"
                    id="mountains">

                <label class="form-check-label" for="mountains">
                    Mountains
                </label>
            </div>
        </li>

        <li>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    name="listing[category]"
                    value="iconic city"
                    id="iconic-city">

                <label class="form-check-label" for="iconic-city">
                    Iconic City
                </label>
            </div>
        </li>

        <li>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    name="listing[category]"
                    value="amazing pool"
                    id="amazing-pool">

                <label class="form-check-label" for="amazing-pool">
                    Amazing Pool
                </label>
            </div>
        </li>

        <li>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    name="listing[category]"
                    value="castles"
                    id="castles">

                <label class="form-check-label" for="castles">
                    Castles
                </label>
            </div>
        </li>

        <li>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    name="listing[category]"
                    value="camping"
                    id="camping">

                <label class="form-check-label" for="camping">
                    Camping
                </label>
            </div>
        </li>

        <li>
            <div class="form-check">
                <input
                    class="form-check-input"
                    type="checkbox"
                    name="listing[category]"
                    value="farming"
                    id="farming">

                <label class="form-check-label" for="farming">
                    Farming
                </label>
            </div>
            </li>

        </ul>
    </div>
        <br>
        <button class="btn btn-dark add-btn">Add</button>
        </form>
        </div>
    </div>
</body>
</html>
